 "BANNER": {
  "h": "43 לדונצ'יץ', והלייקרס ניצחו שמיני ברציפות",
  "p": "הלייקרס גברו בפיניקס 123:131, וסן אנטוניו ניצחה ביוטה 102:110 – 12 ברציפות. סקרמנטו של שארפ (9 נקודות) הפסידה לאוקלהומה סיטי 103:125. הלילה אבדיה ופורטלנד במינסוטה, ווולף וברוקלין מארחים את פילדלפיה."
 },
 "STORIES": {
  "deni": "פורטלנד במאזן 3:9 אחרי שלושה ניצחונות רצופים. אבדיה מוביל את הקבוצה עם 23.9 נקודות, 6.1 ריבאונדים ו-6.3 אסיסטים למשחק, ה-18 בליגה בקליעה. הלילה ומחר פורטלנד משחקת פעמיים במינסוטה, שהלילה תהיה בלי אנתוני אדוארדס הפצוע.",
  "sharp": "שיחק מהספסל בכל 13 משחקי סקרמנטו, עם 4.9 נקודות למשחק ו-36.8% מהשלוש. מול אוקלהומה סיטי השווה את שיא העונה שלו עם 9 נקודות. סקרמנטו במאזן 12:1 אחרי שישה הפסדים רצופים, והמשחק הבא ביום רביעי מול פיניקס.",
  "wolf": "הופיע ב-7 מתוך 12 משחקי ברוקלין ופתח בחמישייה בארבעת האחרונים. בהפסד בממפיס קלע שיא עונתי של 14 נקודות עם 4 שלשות, אחרי דאבל-דאבל עם שיא קריירה של 11 ריבאונדים מול ניו אורלינס. הלילה ברוקלין (9:3) מארחת את פילדלפיה.",
  "saraf": "שיחק 4 דקות ב-NBA העונה, ומאז 26.10 הוא מוצב בלונג איילנד. בניצחון 116:117 על קולג' פארק רשם 19 נקודות, 9 אסיסטים, 2 חטיפות ו-2 חסימות, אחרי 17 נקודות ו-9 אסיסטים במשחק הקודם מול אותה יריבה. הלילה לונג איילנד מארחת את דלאוור."
 },
