 "BANNER": {
  "h": "שיא עונתי לוולף, ומיאמי ניצחה רביעי ברציפות",
  "p": "וולף קלע שיא עונתי של 14 נקודות עם 4 שלשות בהפסד של ברוקלין בממפיס 110:129. מיאמי גברה על דטרויט 117:137 עם 34 נקודות ו-14 ריבאונדים ליאניס. הלילה סקרמנטו של שארפ מארחת את אוקלהומה סיטי."
 },
 "STORIES": {
  "deni": "פורטלנד במאזן 3:9 אחרי שלושה ניצחונות רצופים. אבדיה מוביל את הקבוצה עם 23.9 נקודות, 6.1 ריבאונדים ו-6.3 אסיסטים למשחק, ודמיאן לילארד כינה את השותפות ביניהם המהנה ביותר בקריירה שלו. ביום שני ושלישי פורטלנד משחקת פעמיים במינסוטה.",
  "sharp": "שיחק מהספסל בכל 11 המשחקים הראשונים של סקרמנטו, עם 4.6 נקודות למשחק ו-40.6% מהשלוש. סקרמנטו במאזן 11:1, ללא ניצחון בבית, והלילה היא מארחת את אוקלהומה סיטי.",
  "wolf": "הופיע ב-7 מתוך 12 משחקי ברוקלין ופתח בחמישייה בארבעת האחרונים. בהפסד בממפיס קלע שיא עונתי של 14 נקודות עם 4 שלשות, אחרי דאבל-דאבל עם שיא קריירה של 11 ריבאונדים מול ניו אורלינס. ביום שני ברוקלין מארחת את פילדלפיה.",
  "saraf": "שיחק 4 דקות ב-NBA העונה, ומאז 26.10 הוא מוצב בלונג איילנד. בניצחון 116:117 על קולג' פארק רשם 19 נקודות, 9 אסיסטים, 2 חטיפות ו-2 חסימות, אחרי 17 נקודות ו-9 אסיסטים במשחק הקודם מול אותה יריבה. לונג איילנד במאזן 1:3."
 },
