{
 "BANNER": {
  "h": "בלי אבדיה, פורטלנד הפסידה במינסוטה בשניות האחרונות",
  "p": "אבדיה נעדר בגלל דלקת בכף הרגל, ופורטלנד הפסידה 105:106 אחרי חטיפה של למלו בול וסל של מקדניאלס 2.6 שניות לסיום. 47 לקוונטין גריימס ב-118:114 של הלייקרס על שארלוט בהארכה, ודטרויט עצרה את רצף 12 הניצחונות של סן אנטוניו ב-93:105. הלילה: ברוקלין מארחת את שיקגו וסקרמנטו מארחת את פיניקס."
 },
 "STORIES": {
  "deni": "פורטלנד במאזן 5:9 אחרי שני הפסדים רצופים במינסוטה. אבדיה מוביל את הקבוצה עם 24.2 נקודות, 6.2 ריבאונדים ו-6.1 אסיסטים למשחק, אבל החמיץ את המשחק השני שם בגלל דלקת בכף הרגל השמאלית – ההיעדרות הראשונה שלו העונה.",
  "sharp": "שיחק מהספסל בכל 13 משחקי סקרמנטו, עם 4.9 נקודות למשחק ו-36.8% מהשלוש, ומול אוקלהומה סיטי השווה את שיא העונה שלו עם 9 נקודות. סקרמנטו במאזן 12:1 אחרי שישה הפסדים רצופים, והלילה מארחת את פיניקס בניסיון להימנע מסדרה של 0 מ-7 בבית.",
  "wolf": "הופיע ב-8 מתוך 13 משחקי ברוקלין. אחרי ארבעה משחקים בחמישייה ושיא עונתי של 14 נקודות בממפיס, חזר לספסל מול פילדלפיה וקלע 3 נקודות ב-11 דקות. ברוקלין במאזן 10:3, והלילה מארחת את שיקגו, גם היא ב-10:3.",
  "saraf": "שיחק 4 דקות ב-NBA העונה, ומאז 26.10 הוא מוצב בלונג איילנד. בהפסד 107:108 לדלאוור רשם 17 נקודות, 6 אסיסטים ו-3 חטיפות, אחרי 19 נקודות ו-9 אסיסטים בניצחון על קולג' פארק. לונג איילנד פוגשת שוב את דלאוור."
 },
