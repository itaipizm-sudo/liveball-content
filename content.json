{
 "BANNER": {
  "h": "יאניס ניצח את מילווקי, ברוקלין ספגה תבוסה מהבולס",
  "p": "בפגישה הראשונה מול הקבוצה הוותיקה שלו, יאניס רשם 27 נקודות וכמעט טריפל-דאבל ומיאמי ניצחה 130:137 – שישי ברציפות. שיקגו ריסקה את ברוקלין 107:137 (6 נקודות ו-6 ריבאונדים לוולף), סקרמנטו הפסידה לפיניקס 107:128 וסיימה 0 מ-7 בבית, ויוטה עצרה את הלייקרס 97:109. הלילה: פורטלנד במילווקי, ואבדיה בספק."
 },
 "STORIES": {
  "deni": "פורטלנד במאזן 5:9, שישית במערב. אבדיה מוביל את הקבוצה עם 24.2 נקודות, 6.2 ריבאונדים ו-6.1 אסיסטים למשחק, אבל החמיץ את המשחק האחרון במינסוטה בגלל דלקת בכף הרגל השמאלית, והוא בספק למשחק הלילה במילווקי.",
  "sharp": "הרוקי משחק מהספסל ברוטציה של סקרמנטו, עם כ-18 דקות, 4.9 נקודות ו-36.8% מהשלוש למשחק לפני המשחק מול פיניקס. לפי Roundtable, הנט רייטינג שלו הוא הטוב בקבוצה. סקרמנטו במאזן 13:1 אחרי שבעה הפסדים רצופים ו-0 מ-7 בסדרת המשחקים הביתית.",
  "wolf": "הופיע ב-9 מתוך 14 משחקי ברוקלין, כולל ארבעה בחמישייה ושיא עונתי של 14 נקודות בממפיס. בתבוסה 107:137 לשיקגו רשם מהספסל 6 נקודות, 6 ריבאונדים ו-2 אסיסטים ב-23 דקות. ברוקלין במאזן 11:3.",
  "saraf": "שיחק 4 דקות ב-NBA העונה, ומאז 26.10 הוא מוצב בלונג איילנד, שם הוא מוביל את הג'י ליג באסיסטים. בניצחון 112:123 על דלאוור, אחרי פיגור של 16, רשם דאבל-דאבל של 18 נקודות ו-10 אסיסטים – השחקן הראשון בתולדות המועדון עם 6 אסיסטים לפחות בכל אחד משישת המשחקים הראשונים."
 },
