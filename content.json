{
 "BANNER": {
  "h": "41 לטייטום, בוסטון שברה רצף של ארבעה הפסדים",
  "p": "בוסטון ניצחה את וושינגטון 116:131 עם 41 נקודות של ג'ייסון טייטום. דאלאס ניצחה בדנבר 101:120 (24 נקודות ו-12 אסיסטים לקופר פלאג), ודטרויט בלי קייד קנינגהאם גברה על אורלנדו 86:104. הלילה: פורטלנד מארחת את סן אנטוניו, ברוקלין מול מילווקי וסקרמנטו מול גולדן סטייט."
 },
 "STORIES": {
  "deni": "פורטלנד במאזן 6:11, שביעית במערב. אבדיה מוביל את הקבוצה עם כ-24 נקודות, 6 ריבאונדים ו-6 אסיסטים למשחק, ו-41.5% לשלוש. במשחק האחרון קלע 31 נקודות (5 מ-9 לשלוש) ו-7 אסיסטים בניצחון 111:128 בפילדלפיה. הלילה פורטלנד מארחת את סן אנטוניו, מוליכת המערב, במסגרת גביע ה-NBA.",
  "sharp": "הרוקי משחק מהספסל ברוטציה של סקרמנטו, עם פחות מ-5 נקודות בכ-16 דקות בממוצע. בהפסד האחרון, 107:123 לסן אנטוניו, לא קלע. סקרמנטו במאזן 15:2, והלילה מארחת את גולדן סטייט.",
  "wolf": "הופיע ב-11 מתוך 16 משחקי ברוקלין, שישה מהם בחמישייה, עם כ-10 נקודות ו-5.6 ריבאונדים בממוצע ו-51% לשלוש, מהטובים בליגה. המאמן ג'ורדי פרננדס העביר אותו לחמישייה בזכות ההגנה והריבאונד. ברוקלין במאזן 13:3, והלילה פוגשת את מילווקי.",
  "saraf": "שיחק 4 דקות ב-NBA העונה, ורוב הזמן מוצב בלונג איילנד, שם הוא מוביל את הג'י ליג באסיסטים: 16.7 נקודות ו-8.8 אסיסטים בממוצע בשישה משחקים. ב-22.11 הוצב שם שוב לקראת המשחק מול קפיטל סיטי גו-גו."
 },
