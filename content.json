{
 "BANNER": {
  "h": "פורטלנד ברבע גמר הגביע: 94:116 על גולדן סטייט",
  "p": "אבדיה קלע 26 נקודות ופורטלנד סיימה ראשונה בבית ותארח את ממפיס ב-5.12. דאלאס חזרה מפיגור 21 ל-109:113 על פיניקס, סן אנטוניו ניצחה את הלייקרס 96:99, וברוקלין הפסידה בטורונטו 100:124. הלילה ברוקלין בשארלוט ואוקלהומה סיטי מול מילווקי."
 },
 "STORIES": {
  "deni": "פורטלנד במאזן 13 ניצחונות ו-6 הפסדים. אבדיה מוביל את הקבוצה עם יותר מ-24 נקודות ו-6 אסיסטים למשחק. בניצחון 94:116 על גולדן סטייט, בלי דמיאן לילארד, קלע 26 נקודות עם 7 אסיסטים, ופורטלנד סיימה ראשונה בבית בגביע. ברבע הגמר היא תארח את ממפיס ב-5 בדצמבר, ולפני כן תארח את ניו אורלינס.",
  "sharp": "הרוקי פתח לראשונה בקריירה בהפסד 110:129 בגולדן סטייט, וקלע 9 נקודות (3 מ-6 לשלוש). בעונה הוא קולע כ-4.7 נקודות בכ-17 דקות ב-18 משחקים. סקרמנטו במאזן 2 ניצחונות ו-16 הפסדים, והמשחק הבא שלה מול מינסוטה.",
  "wolf": "פותח בחמישייה של ברוקלין בעמדת הגארד, עם קרוב ל-10 נקודות למשחק. בהפסד 100:124 בטורונטו קלע 5 נקודות. ברוקלין במאזן 4 ניצחונות ו-14 הפסדים, נפרדה מהגביע, והלילה מתארחת בשארלוט.",
  "saraf": "הוחזר מלונג איילנד לסגל של ברוקלין אחרי הפציעה של נולאן טראורה, וקלע 4 נקודות בהפסד בטורונטו. זה המשחק השני שלו ב-NBA העונה; בג'י ליג הוביל את לונג איילנד עם כ-17 נקודות ו-9 אסיסטים בממוצע."
 },
