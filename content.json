{
 "BANNER": {
  "h": "27 לאבדיה, אבל פורטלנד נעצרה במינסוטה",
  "p": "פורטלנד הפסידה למינסוטה 98:106 למרות 27 של אבדיה, וברוקלין של וולף הפסידה לפילדלפיה 123:135 עם 37 לאמביד. הלילה אבדיה ופורטלנד שוב במינסוטה, בשני המשחקים ברציפות בין הקבוצות."
 },
 "STORIES": {
  "deni": "פורטלנד במאזן 4:9 אחרי שרצף שלושת הניצחונות נעצר במינסוטה. אבדיה מוביל את הקבוצה עם כ-24 נקודות, 6 ריבאונדים ו-6 אסיסטים למשחק, ובהפסד קלע 27 עם 11 מ-19 מהשדה ו-3 מ-3 מהשלוש. הלילה פורטלנד שוב במינסוטה.",
  "sharp": "שיחק מהספסל בכל 13 משחקי סקרמנטו, עם 4.9 נקודות למשחק ו-36.8% מהשלוש. מול אוקלהומה סיטי השווה את שיא העונה שלו עם 9 נקודות. סקרמנטו במאזן 12:1 אחרי שישה הפסדים רצופים, והמשחק הבא מחר מול פיניקס.",
  "wolf": "הופיע ב-8 מתוך 13 משחקי ברוקלין. אחרי ארבעה משחקים בחמישייה ושיא עונתי של 14 נקודות בממפיס, חזר לספסל מול פילדלפיה וקלע 3 נקודות ב-11 דקות. ברוקלין במאזן 10:3, ומחר מארחת את שיקגו.",
  "saraf": "שיחק 4 דקות ב-NBA העונה, ומאז 26.10 הוא מוצב בלונג איילנד. בהפסד 107:108 לדלאוור רשם 17 נקודות, 6 אסיסטים ו-3 חטיפות, אחרי 19 נקודות ו-9 אסיסטים בניצחון על קולג' פארק. מחר לונג איילנד מארחת שוב את דלאוור."
 },
