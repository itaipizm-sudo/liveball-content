{
 "BANNER": {
  "h": "20 נקודות לוולף בחמישייה, אבל וגנר הכריע את ברוקלין",
  "p": "ברוקלין הפסידה לאורלנדו 111:113 אחרי סל של פרנץ וגנר (35 נקודות) 2.4 שניות לסיום, ודני וולף קלע 20 עם 4 שלשות. הלייקרס גברו על סקרמנטו 104:106, ודנבר ניצחה את יוסטון 124:133 עם 26 נקודות ו-11 אסיסטים ליוקיץ'. הלילה: פורטלנד בניו יורק (אבדיה בספק) וסקרמנטו מארחת את בוסטון."
 },
 "STORIES": {
  "deni": "פורטלנד במאזן 5:10, שישית במערב. אבדיה מוביל את הקבוצה עם 24.2 נקודות, 6.2 ריבאונדים ו-6.1 אסיסטים למשחק, אבל החמיץ שני משחקים רצופים בגלל חבלה בכף הרגל השמאלית. הלילה בניו יורק הוא מוגדר בספק.",
  "sharp": "הרוקי משחק מהספסל ברוטציה של סקרמנטו, ולפי Roundtable הנט רייטינג שלו הוא הטוב בקבוצה. בהפסד 104:106 ללייקרס קלע 3 נקודות (1 מ-5 מהשדה). סקרמנטו במאזן 14:1 אחרי שמונה הפסדים רצופים, והלילה היא מארחת את בוסטון.",
  "wolf": "הופיע ב-10 מתוך 15 משחקי ברוקלין, חמישה מהם בחמישייה. בהפסד 111:113 לאורלנדו חזר לחמישייה וקבע שיא עונתי חדש: 20 נקודות (6 מ-10, 4 שלשות), 5 ריבאונדים ו-+15, הטוב בקבוצה. ברוקלין במאזן 12:3 אחרי ארבעה הפסדים רצופים.",
  "saraf": "שיחק 4 דקות ב-NBA העונה, ומאז 26.10 הוא מוצב בלונג איילנד, שם הוא מוביל את הג'י ליג באסיסטים. בניצחון 112:123 על דלאוור, אחרי פיגור של 16, רשם דאבל-דאבל של 18 נקודות ו-10 אסיסטים – השחקן הראשון בתולדות המועדון עם 6 אסיסטים לפחות בכל אחד משישת המשחקים הראשונים."
 },
